<!-- #################################################   JOINTS   ###################################################### -->

  <!-- **************************   Lower Body   ***************************** -->
  <!-- Torso and Left Thigh -->
  <joint name="TorsoThigh_Left" type="continuous">
    <origin xyz="-0.11512 -0.065021 0.55768" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="Thigh_Left" />
    <axis xyz="1 0 0" />
    <limit effort="10" velocity="5" lower="-1.0" upper="1.0"/>
  </joint>

  <!-- Left Thigh and Calf -->
  <joint name="ThighCalf_Left" type="continuous">
    <origin xyz="0.05817 -0.01741 -0.31668" rpy="0 0 0" />
    <parent link="Thigh_Left" />
    <child link="Calf_Left" />
    <axis xyz="0.0094744 0.99913 -0.040492" />
  </joint>

  <!-- Left Calf and Foot -->
  <joint name="CalfFeet_Left" type="continuous">
    <origin xyz="0.038123 -0.020637 -0.17389" rpy="0 0 0" />
    <parent link="Calf_Left" />
    <child link="Feet_Left" />
    <axis xyz="0.0094744 0.99913 -0.040492" />
  </joint>

  <!-- Torso and Right Thigh -->
  <joint name="TorsoThigh_Right" type="continuous">
    <origin xyz="-0.11209 -0.0024223 0.55516" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="Thigh_Right" />
    <axis xyz="-1 0 0" />
  </joint>

  <!-- Right Thigh and Calf -->
  <joint name="ThighCalf_Right" type="continuous">
    <origin xyz="0.091715 -0.00051607 -0.31612" rpy="0 0 0" />
    <parent link="Thigh_Right" />
    <child link="Calf_Right" />
    <axis xyz="-0.15989 0.98597 -0.047997" />
  </joint>

  <!-- Right Calf and Feet -->
  <joint name="CalfFeet_Right" type="continuous">
    <origin xyz="0.022955 0.0053424 -0.17745" rpy="0 0 0" />
    <parent link="Calf_Right" />
    <child link="Feet_Right" />
    <axis xyz="-0.15989 0.98597 -0.047997" />
  </joint>

  <!-- **************************   Upper Body   ***************************** -->
  <!-- Neck -->
  <joint name="Neck" type="continuous">
