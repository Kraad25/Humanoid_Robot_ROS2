<?xml version="1.0" encoding="utf-8"?>

<robot name="Selene">
  <!-- #################################################   LINKS   ###################################################### -->

  <!-- Torso -->
  <link name="base_link">
    <inertial>
      <origin xyz="-0.0452 -0.03692 0.6860" rpy="0 0 0" />
      <mass value="3.7818" />
      <inertia ixx="0.0290" ixy="-2.3495E-05" ixz="0.0020" iyy="0.02825" iyz="0.0003"
              izz="0.00985571938524551" />
      </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///$(find humanoid_robot)/meshes/base_link.STL" />
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///$(find humanoid_robot)/meshes/base_link.STL" />
      </geometry>
    </collision>
  </link>


  <!-- **************************   Lower Body   ***************************** -->
