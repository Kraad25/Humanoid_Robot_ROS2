            <parent link="base_link" />
            <child link="RShoulder_Roll_Link" />
            <axis xyz="1 0 0" />
            <limit lower="0" upper="1.0472" effort="1.0" velocity="1.0"/> <!-- 0 - 60 degrees -->
            <dynamics damping="0.2" friction="0.5"/>
