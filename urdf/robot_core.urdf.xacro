            <child link="Elbow_Left" />
            <axis xyz="0 1 0" />
            <limit lower="-1.74533" upper="0.349066" effort="1.0" velocity="1.0"/> <!-- (-20) - 100 deg-->
            <dynamics damping="0.15" friction="0.2"/>
        </joint>

        <joint name="ElbowPalm_Left" type="fixed">
            <origin xyz="0.03 -0.003 -0.14" rpy="0 0 0" />
