            <child link="Foot_Right" />
            <axis xyz="0 1 0" />
            <limit lower="-0.785398" upper="0.785398" effort="1.0" velocity="1.0"/> <!-- 45 degrees-->
            <dynamics damping="0.2" friction="0.5"/>
        </joint>

        <!-- ****************************   IMU Sensor   **************************** -->
        <!-- IMU Link -->
        <link name="imu_link">
            <inertial>
                <mass value = "0.1"/>
                <origin value = "0 0 0"/>
                <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.01"/>
            </inertial>

            <visual>
                <geometry>
                    <sphere radius="0.005"/>
                </geometry>
                <origin xyz="0 0 0" rpy="0 0 0"/>
            </visual>

            <collision>
                <geometry>
                    <sphere radius="0.005"/>
                </geometry>
                <origin xyz="0 0 0" rpy="0 0 0"/>
            </collision>
        </link>

        <!-- IMU Joint -->
        <joint name="imu_base_link_joint" type="fixed">
            <parent link="base_link"/>
            <child link="imu_link"/>
            <origin xyz="0 0.01 0.6" rpy="0 0 0"/>
        </joint>


        <!-- ****************************   Camera   **************************** -->
        <!-- Camera Link -->
        <link name="eye_left_link">
        <inertial>
            <mass value="0.01"/>
            <origin xyz="0 0 0"/>
            <inertia ixx="1e-6" ixy="0" ixz="0"
                    iyy="1e-6" iyz="0"
                    izz="1e-6"/>
        </inertial>

        <visual>
            <geometry>
                <sphere radius="0.003"/>
            </geometry>
            <origin xyz="0 0 0"/>
        </visual>

        <collision>
            <geometry>
                <sphere radius="0.003"/>
            </geometry>
            <origin xyz="0 0 0"/>
        </collision>
        </link>

        <link name="eye_right_link">
        <inertial>
            <mass value="0.01"/>
            <origin xyz="0 0 0"/>
            <inertia ixx="1e-6" ixy="0" ixz="0"
                    iyy="1e-6" iyz="0"
                    izz="1e-6"/>
        </inertial>

        <visual>
            <geometry>
                <sphere radius="0.003"/>
            </geometry>
            <origin xyz="0 0 0"/>
        </visual>

        <collision>
            <geometry>
                <sphere radius="0.003"/>
            </geometry>
            <origin xyz="0 0 0"/>
        </collision>
        </link>

        <!-- Camera Joint -->
        <joint name="left_camera_joint" type="fixed">
            <parent link="Head"/>
            <child link="eye_left_link"/>
            <origin xyz="0.035 -0.018 0.077" rpy="0 0 0"/>
        </joint>

        <joint name="right_camera_joint" type="fixed">
            <parent link="Head"/>
            <child link="eye_right_link"/>
            <origin xyz="0.035 0.018 0.077" rpy="0 0 0"/>
        </joint>

        <gazebo reference="eye_left_link">
            <material>Gazebo/Grey</material>
        </gazebo>

        <gazebo reference="eye_right_link">
            <material>Gazebo/Grey</material>
        </gazebo>
    </xacro:macro>
</robot>