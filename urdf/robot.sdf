    <!-- Right Thigh and Torso -->
    <joint name='TorsoThigh_Right_Pitch' type='revolute'>
      <pose relative_to='base_link'>-0.015152 0.040137 0.55044 0 -0 0</pose>
      <parent>base_link</parent>
      <child>RThigh_Pitch</child>
      <axis>
      <xyz>0 1 0</xyz>
      <limit>
          <lower>-3.14159</lower> <!-- 60 - 180 degrees-->
          <upper>0.349066</upper>
      </limit>
      <dynamics>
          <friction>0.5</friction>
      </dynamics>
      </axis>
      
      <sensor name="force_torque_sensor" type="force_torque">
