    <!-- RThigh_Pitch (This is a dummy link which allows us to split a universal into 2 revolute joints) -->
    <link name='RThigh_Pitch'>
      <pose relative_to='TorsoThigh_Right_Pitch'>0 0 0 0 0 0</pose>
    </link>

    <joint name='TorsoThigh_Right_Yaw' type='revolute'>
      <pose relative_to='base_link'>-0.015152 0.040137 0.55044 0 -0 0</pose>
      <parent>RThigh_Pitch</parent>
      <child>Thigh_Right</child>
      <axis>
