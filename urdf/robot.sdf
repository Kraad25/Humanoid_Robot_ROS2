    <!-- #######################################################   JOINTS   ################################################################### -->
    <joint name="world_joint" type="fixed">
        <parent>world</parent>
        <child>base_link</child>
    </joint>

    
    <!-- Neck -->
    <joint name='Neck_Yaw' type='revolute'>
      <pose relative_to='base_link'>-0.044306 0.010853 0.81525 0 0 0</pose>
      <parent>base_link</parent>
      <child>Neck_Yaw_Link</child>

      <!-- (Left/Right Movement) -->
      <axis>
        <xyz>0 0 1</xyz> 
        <limit>
            <lower>-1.0472</lower>  <!-- 60 degrees-->
            <upper>1.0472</upper> 
        </limit>
        <dynamics>
            <damping>0.05</damping>
            <friction>0.5</friction>
        </dynamics>
      </axis>

      <sensor name="force_torque_sensor" type="force_torque">
        <pose degrees="true">0 0 0.0   30 0 0</pose>
        <update_rate>100</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <topic>force_torque1</topic>
        <force_torque>
          <frame>child</frame>
          <measure_direction>parent_to_child</measure_direction>
        </force_torque>
      </sensor>

    </joint>

    <!-- Neck Yaw Link (This is a dummy link which allows us to split a universal into 2 revolute joints) -->
    <link name='Neck_Yaw_Link'>
      <pose relative_to='Neck_Yaw'>0 0 0 0 0 0</pose>
    </link>
    
    <joint name='Neck_Pitch' type='revolute'>
      <pose relative_to='base_link'>-0.044306 0.010853 0.81525 0 0 0</pose>
      <parent>Neck_Yaw_Link</parent>
      <child>Head</child>

      <!-- (Up/Down Movement) -->
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
            <lower>-0.523599</lower>  <!-- 30 degrees -->
            <upper>0.523599</upper> 
        </limit>
        <dynamics>
            <damping>0.05</damping>
            <friction>0.5</friction>
        </dynamics>
      </axis>

      <sensor name="force_torque_sensor" type="force_torque">
        <pose degrees="true">0 0 0.0   30 0 0</pose>
        <update_rate>100</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <topic>force_torque1</topic>
        <force_torque>
          <frame>child</frame>
          <measure_direction>parent_to_child</measure_direction>
        </force_torque>
      </sensor>

    </joint>

    <!-- Left Shoulder and Torso -->
    <joint name='TorsoShoulder_Left_Pitch' type='revolute'>
      <pose relative_to='base_link'>-0.033379 -0.064693 0.78215 0 -0 0</pose>
      <parent>base_link</parent>
      <child>LShoulder_Pitch</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
            <lower>-3.14159</lower>  <!-- -20 - 180 degrees-->
            <upper>0.349066</upper>
        </limit>
        <dynamics>
            <damping>0.05</damping>
            <friction>0.5</friction>
        </dynamics>
      </axis>

      <sensor name="force_torque_sensor" type="force_torque">
        <pose degrees="true">0 0 0.0   30 0 0</pose>
        <update_rate>100</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <topic>force_torque2</topic>
        <force_torque>
          <frame>child</frame>
          <measure_direction>parent_to_child</measure_direction>
        </force_torque>
      </sensor>
    </joint>

    <!-- LShoulder_Pitch (This is a dummy link which allows us to split a universal into 2 revolute joints) -->
    <link name='LShoulder_Pitch'>
      <pose relative_to='TorsoShoulder_Left_Pitch'>0 0 0 0 0 0</pose>
    </link>

    <joint name='TorsoShoulder_Left_Roll' type='revolute'>
      <pose relative_to='base_link'>-0.033379 -0.064693 0.78215 0 -0 0</pose>
      <parent>LShoulder_Pitch</parent>
      <child>Shoulder_Left</child>
      <axis>
        <xyz>1 0 0</xyz> 
        <limit>
            <lower>-1.0472</lower>  <!-- 0 - 60 degrees -->
            <upper>0</upper> 
        </limit>
        <dynamics>
            <damping>0.05</damping>
            <friction>0.5</friction>
        </dynamics>
      </axis>

      <sensor name="force_torque_sensor" type="force_torque">
        <pose degrees="true">0 0 0.0   30 0 0</pose>
        <update_rate>100</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <topic>force_torque2</topic>
        <force_torque>
          <frame>child</frame>
          <measure_direction>parent_to_child</measure_direction>
        </force_torque>
      </sensor>
    </joint>

    <!-- Left Elbow and Shoulder -->
    <joint name='ShoulderElbow_Left' type='revolute'>
      <pose relative_to='Shoulder_Left'>-0.000732 -0.040103 -0.14681 0 -0 0</pose>
      <parent>Shoulder_Left</parent>
      <child>Elbow_Left</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
            <lower>-1.74533</lower>    <!-- -20 - 100 deg-->
            <upper>0.349066</upper>
        </limit>
        <dynamics>
            <damping>0.05</damping>
            <friction>0.5</friction>
        </dynamics>
      </axis>

      <sensor name="force_torque_sensor" type="force_torque">
        <pose degrees="true">0 0 0.0   30 0 0</pose>
        <update_rate>100</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <topic>force_torque3</topic>
        <force_torque>
          <frame>child</frame>
          <measure_direction>parent_to_child</measure_direction>
        </force_torque>
      </sensor>
    </joint>

    <!-- Right Shoulder and Torso -->
    <joint name='TorsoShoulder_Right_Pitch' type='revolute'>
      <pose relative_to='base_link'>-0.033308 0.08489 0.77914 0 -0 0</pose>
      <parent>base_link</parent>
      <child>RShoulder_Pitch</child>
      <axis>
        <xyz>0 1 0</xyz>  <!-- Rotation around Y-axis -->
        <limit>
            <lower>-3.14159</lower>  <!-- -20 - 180 degrees-->
            <upper>0.349066</upper>
        </limit>
        <dynamics>
            <damping>0.05</damping>
            <friction>0.5</friction>
        </dynamics>
      </axis>

      <sensor name="force_torque_sensor" type="force_torque">
        <pose degrees="true">0 0 0.0   30 0 0</pose>
        <update_rate>100</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <topic>force_torque4</topic>
        <force_torque>
          <frame>child</frame>
          <measure_direction>parent_to_child</measure_direction>
        </force_torque>
      </sensor>
    </joint>

    <!-- RShoulder_Pitch (This is a dummy link which allows us to split a universal into 2 revolute joints) -->
    <link name='RShoulder_Pitch'>
      <pose relative_to='TorsoShoulder_Right_Pitch'>0 0 0 0 0 0</pose>
    </link>

    <joint name='TorsoShoulder_Right_Roll' type='revolute'>
      <pose relative_to='base_link'>-0.033308 0.08489 0.77914 0 -0 0</pose>
      <parent>RShoulder_Pitch</parent>
      <child>Shoulder_Right</child>
      <axis>
        <xyz>1 0 0</xyz>  <!-- Rotation around X-axis -->
        <limit>
            <lower>0</lower>  <!-- 0 - 60 degrees -->
            <upper>1.0472</upper> 
        </limit>
        <dynamics>
            <damping>0.05</damping>
            <friction>0.5</friction>
        </dynamics>
      </axis>

      <sensor name="force_torque_sensor" type="force_torque">
        <pose degrees="true">0 0 0.0   30 0 0</pose>
        <update_rate>100</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <topic>force_torque4</topic>
        <force_torque>
          <frame>child</frame>
          <measure_direction>parent_to_child</measure_direction>
        </force_torque>
      </sensor>
    </joint>

    <!-- Right Elbow and Shoulder -->
    <joint name='ShoulderElbow_Right' type='revolute'>
      <pose relative_to='Shoulder_Right'>-0.000732 0.040103 -0.14681 0 -0 0</pose>
      <parent>Shoulder_Right</parent>
      <child>Elbow_Right</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
            <lower>-1.74533</lower>    <!-- -20 to 100 deg-->
            <upper>0.349066</upper>
        </limit>
        <dynamics>
            <damping>0.05</damping>
            <friction>0.5</friction>
        </dynamics>
      </axis>

      <sensor name="force_torque_sensor" type="force_torque">
        <pose degrees="true">0 0 0.0   30 0 0</pose>
        <update_rate>100</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <topic>force_torque5</topic>
        <force_torque>
          <frame>child</frame>
          <measure_direction>parent_to_child</measure_direction>
        </force_torque>
      </sensor>
    </joint>

    <!-- Left Thigh and Torso -->
    <joint name='TorsoThigh_Left_Pitch' type='revolute'>
      <pose relative_to='base_link'>-0.013335 -0.010993 0.55295 0 -0 0</pose>
      <parent>base_link</parent>
      <child>LThigh_Pitch</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
            <lower>-2.0944</lower> <!-- -60 - 120 degrees-->
            <upper>0.349066</upper>
        </limit>
        <dynamics>
            <friction>0.5</friction>
        </dynamics>
      </axis>

      <sensor name="force_torque_sensor" type="force_torque">
        <pose degrees="true">0 0 0.0   30 0 0</pose>
        <update_rate>100</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <topic>force_torque6</topic>
        <force_torque>
          <frame>child</frame>
          <measure_direction>parent_to_child</measure_direction>
        </force_torque>
      </sensor>
    </joint>

    <!-- LThigh_Pitch (This is a dummy link which allows us to split a universal into 2 revolute joints) -->
    <link name='LThigh_Pitch'>
      <pose relative_to='TorsoThigh_Left_Pitch'>0 0 0 0 0 0</pose>
    </link>

    <joint name='TorsoThigh_Left_Yaw' type='revolute'>
      <pose relative_to='base_link'>-0.013335 -0.010993 0.55295 0 -0 0</pose>
      <parent>LThigh_Pitch</parent>
      <child>Thigh_Left</child>
      
      <axis>
        <xyz>0 0 1</xyz> 
        <limit>
            <lower>-0.0872665</lower>  <!-- -5 - 20 degrees -->
            <upper>0.349066</upper> 
        </limit>
        <dynamics>
            <friction>0.5</friction>
        </dynamics>
      </axis>

    <sensor name="force_torque_sensor" type="force_torque">
        <pose degrees="true">0 0 0.0   30 0 0</pose>
        <update_rate>100</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <topic>force_torque6</topic>
        <force_torque>
          <frame>child</frame>
          <measure_direction>parent_to_child</measure_direction>
        </force_torque>
      </sensor>
    </joint>

    <!-- Left Calf and Thigh -->
    <joint name='ThighCalf_Left' type='revolute'>
      <pose relative_to='Thigh_Left'>0.009424 -0.039542 -0.32005 0 -0 0</pose>
      <parent>Thigh_Left</parent>
      <child>Calf_Left</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
            <lower>-0.349066</lower> <!-- -20 - 100 degrees-->
            <upper>1.74533</upper>
        </limit>
        <dynamics>
            <friction>0.5</friction>
        </dynamics>
      </axis>

      <sensor name="force_torque_sensor" type="force_torque">
        <pose degrees="true">0 0 0.0   30 0 0</pose>
        <update_rate>100</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <topic>force_torque7</topic>
        <force_torque>
          <frame>child</frame>
          <measure_direction>parent_to_child</measure_direction>
        </force_torque>
      </sensor>
    </joint>

    <!-- Left Foot and Calf -->
    <joint name='CalfFoot_Left' type='revolute'>
      <pose relative_to='Calf_Left'>0.039418 -0.002447 -0.17177 0 -0 0</pose>
      <parent>Calf_Left</parent>
      <child>Foot_Left</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
            <lower>-0.785398</lower> <!-- 45 degrees-->
            <upper>0.785398</upper>
        </limit>
        <dynamics>
            <friction>0.5</friction>
