    <!-- ****************************   IMU Sensor   **************************** -->
    <!-- IMU Link -->
    <link name="IMU_Link">
        <inertial>
          <pose>0 0.01 0.6 0 0 0</pose>
          <mass>0.1</mass>
          <inertia>
              <ixx>0.01</ixx> <ixy>0.0</ixy> <ixz>0.0</ixz>
              <iyy>0.01</iyy> <iyz>0.0</iyz> <izz>0.01</izz>
          </inertia>
        </inertial>

        <visual name="IMU_visual">
          <pose>0 0.01 0.6 0 -0 0</pose>
          <geometry>
            <sphere>
                <radius>0.005</radius>
            </sphere>
          </geometry>
        </visual>

        <collision name="IMU_collision">
          <pose>0 0.01 0.6 0 -0 0</pose>
          <geometry>
            <sphere>
                <radius>0.005</radius>
            </sphere>
          </geometry>
        </collision>

        <sensor name="imu_sensor" type="imu">
          <always_on>true</always_on>
          <update_rate>100</update_rate>
          <pose>0 0.01 0.6 0 -0 0</pose>
          <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
              <updateRateHZ>100.0</updateRateHZ>
              <gaussianNoise>0.05</gaussianNoise>
              <xyzOffset>0 0 0</xyzOffset>
              <rpyOffset>0 0 0</rpyOffset>
              <frameName>IMU_Link</frameName>
              <initialOrientationAsReference>false</initialOrientationAsReference>
          </plugin>
        </sensor>
    </link>

    <joint name="IMU_Torso_Joint" type="fixed">
      <pose>0 0.01 0.6 0 -0 0</pose>
      <parent>base_link</parent>
      <child>IMU_Link</child>
    </joint>


  <plugin name="joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
    <ros>
      <namespace>/</namespace>
      <remapping>joint_states:=/joint_states</remapping>
    </ros>
    <joint_name>Neck_Pitch</joint_name>
    <joint_name>Neck_Yaw</joint_name>

    <joint_name>TorsoShoulder_Left_Pitch</joint_name>
    <joint_name>TorsoShoulder_Left_Roll</joint_name>
    <joint_name>ShoulderElbow_Left</joint_name>

    <joint_name>TorsoShoulder_Right_Pitch</joint_name>
    <joint_name>TorsoShoulder_Right_Roll</joint_name>
    <joint_name>ShoulderElbow_Right</joint_name>

    <joint_name>TorsoThigh_Left_Pitch</joint_name>
    <joint_name>TorsoThigh_Left_Yaw</joint_name>
    <joint_name>ThighCalf_Left</joint_name>
    <joint_name>CalfFoot_Left</joint_name>

    <joint_name>TorsoThigh_Right_Pitch</joint_name>
    <joint_name>TorsoThigh_Right_Yaw</joint_name>
    <joint_name>ThighCalf_Right</joint_name>
    <joint_name>CalfFoot_Right</joint_name>
    <update_rate>50</update_rate>
  </plugin>

  <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
    <parameters>file:///home/drak/ros2_ws/src/humanoid_robot/config/controller_config.yaml</parameters>
  </plugin>

  <transmission name="Neck_Yaw_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="Neck_Yaw">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="Neck_Yaw_motor">
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  </model>
</sdf>