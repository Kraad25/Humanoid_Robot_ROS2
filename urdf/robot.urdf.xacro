<?xml version="1.0"?>

<robot name="Selene" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- #######################################################   LINKS   ################################################################### -->
  <!-- Base -->
  <link name="base_link">
    <inertial>
      <origin xyz="-0.0100023420943865 0.0113704665181975 0.674727562757712" rpy="0 0 0" />
      <mass value="3.78181180876983" />
      <inertia
        ixx="0.0289881715545131" ixy="-2.34952842388438E-05" ixz="0.00203838739877037"
        iyy="0.0282471940044164" iyz="0.000277812220276223" izz="0.00985571887812677" />
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="$(find humanoid_robot)/meshes/base_link.STL"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="$(find humanoid_robot)/meshes/base_link.STL"/>
      </geometry>
    </collision>
  </link>

  <!-- #####  UPPER BODY  ##### -->

