      <force_torque>
        <frame>child</frame>
        <measure_direction>parent_to_child</measure_direction>
      </force_torque>
      <pose>0 0 0 0 0 0</pose>
    </sensor>
  </gazebo>

  <!-- Left Elbow Pitch -->
