  <link name="world"/>


  <!-- #######################################################   JOINTS   ################################################################### -->
  <joint name="Hang" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
  </joint>

  <!-- Neck -->
  <joint name="Neck_Yaw" type="revolute">
    <origin xyz="-0.044306 0.010853 0.81525" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="Neck_Yaw_Link" />
    <axis xyz="0 0 1" />
    <limit lower="-1.0472" upper="1.0472" effort="1.0" velocity="1.0"/> <!-- 60 degrees-->
    <dynamics damping="0.05" friction="0.5"/> 
  </joint>

  <joint name="Neck_Pitch" type="revolute">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="Neck_Yaw_Link" />
    <child link="Head" />
    <axis xyz="0 1 0" />
    <limit lower="-0.523599" upper="0.523599" effort="1.0" velocity="1.0"/> <!-- 30 degrees -->
    <dynamics damping="0.05" friction="0.5"/>
  </joint>

  <!-- Left Shoulder and Torso Roll -->
  <joint name="TorsoShoulder_Left_Roll" type="revolute">
    <origin xyz="-0.033379 -0.064693 0.78215" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="LShoulder_Roll_Link" />
    <axis xyz="1 0 0" />
    <limit lower="-1.0472" upper="0" effort="1.0" velocity="1.0"/> <!-- 0 - 60 degrees -->
    <dynamics damping="0.05" friction="0.5"/>
  </joint>

  <!-- Left Shoulder Pitch -->
  <joint name="TorsoShoulder_Left_Pitch" type="revolute">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="LShoulder_Roll_Link" />
    <child link="LShoulder_Pitch_Link" />
    <axis xyz="0 1 0" />
    <limit lower="-3.14159" upper="0.349066" effort="1.0" velocity="1.0"/> <!-- (-20) - 180 degrees-->
    <dynamics damping="0.05" friction="0.5"/>
  </joint>

  <!-- Left Elbow and Shoulder -->
  <joint name="ShoulderElbow_Left" type="revolute">
    <origin xyz="-0.00073185 -0.040103 -0.14681" rpy="0 0 0" />
    <parent link="LShoulder_Pitch_Link" />
    <child link="Elbow_Left" />
    <axis xyz="-0.025189 0.99968 0" />
    <limit lower="-1.74533" upper="0.349066" effort="1.0" velocity="1.0"/> <!-- (-20) - 100 deg-->
    <dynamics damping="0.05" friction="0.5"/>
  </joint>

  <!-- Right Shoulder and Torso Roll-->
  <joint name="TorsoShoulder_Right_Roll" type="revolute">
    <origin xyz="-0.033308 0.08489 0.77914" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="RShoulder_Roll_Link" />
    <axis xyz="1 0 0" />
    <limit lower="0" upper="1.0472" effort="1.0" velocity="1.0"/> <!-- 0 - 60 degrees -->
    <dynamics damping="0.05" friction="0.5"/>
  </joint>

  <!-- Right Shoulder Pitch -->
  <joint name="TorsoShoulder_Right_Pitch" type="revolute">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="RShoulder_Roll_Link" />
    <child link="RShoulder_Pitch_Link" />
    <axis xyz="0 1 0" />
    <limit lower="-3.14159" upper="0.349066" effort="1.0" velocity="1.0"/> <!-- (-20) - 180 degrees-->
    <dynamics damping="0.05" friction="0.5"/>
  </joint>

  <!-- Right Elbow and Shoulder -->
  <joint name="ShoulderElbow_Right" type="revolute">
    <origin xyz="-0.00073185 0.040103 -0.14681" rpy="0 0 0" />
    <parent link="RShoulder_Pitch_Link" />
    <child link="Elbow_Right" />
    <axis xyz="0.025189 0.99968 0" />
    <limit lower="-1.74533" upper="0.349066" effort="1.0" velocity="1.0"/> <!-- (-20) to 100 deg-->
    <dynamics damping="0.05" friction="0.5"/>
  </joint>

  <!-- Left Thigh and Torso Yaw -->
  <joint name="TorsoThigh_Left_Yaw" type="revolute">
    <origin xyz="-0.013335 -0.010993 0.55295" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="LThigh_Yaw_Link" />
    <axis xyz="0 0 1" />
    <limit lower="-0.0872665" upper="0.349066" effort="1.0" velocity="1.0"/> <!-- (-5) - 20 degrees -->
    <dynamics damping="0.05" friction="0.5"/>
  </joint>

  <!-- Left Thigh and Torso Pitch -->
  <joint name="TorsoThigh_Left_Pitch" type="revolute">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="LThigh_Yaw_Link" />
    <child link="LThigh_Pitch_Link" />
    <axis xyz="0 1 0" />
    <limit lower="-2.0944" upper="0.349066" effort="1.0" velocity="1.0"/> <!-- (-60) - 120 degrees-->
    <dynamics damping="0.05" friction="0.5"/>
  </joint>

  <!-- Left Calf and Thigh -->
  <joint name="ThighCalf_Left" type="revolute">
    <origin xyz="0.0094239 -0.039542 -0.32005" rpy="0 0 0" />
    <parent link="LThigh_Pitch_Link" />
    <child link="Calf_Left" />
    <axis xyz="0 1 0" />
    <limit lower="-0.349066" upper="1.74533" effort="1.0" velocity="1.0"/> <!-- (-20) - 100 degrees-->
    <dynamics damping="0.05" friction="0.5"/>
  </joint>

  <!-- Left Foot and Calf -->
  <joint name="CalfFoot_Left" type="revolute">
    <origin xyz="0.039418 -0.0024472 -0.17177" rpy="0 0 0" />
    <parent link="Calf_Left" />
    <child link="Foot_Left" />
    <axis xyz="0 1 0" />
    <limit lower="-0.785398" upper="0.785398" effort="1.0" velocity="1.0"/> <!-- 45 degrees-->
    <dynamics damping="0.05" friction="0.5"/>
  </joint>

  <!-- Right Thigh and Torso Yaw -->
  <joint name="TorsoThigh_Right_Yaw" type="revolute">
    <origin xyz="-0.015152 0.040137 0.55044" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="RThigh_Yaw_Link" />
    <axis xyz="0 0 1" />
    <limit lower="-0.0872665" upper="0.349066" effort="1.0" velocity="1.0"/> <!-- (-5) - 20 degrees -->
    <dynamics damping="0.05" friction="0.5"/>
  </joint>

  <!-- Right Thigh and Torso Pitch -->
  <joint name="TorsoThigh_Right_Pitch" type="revolute">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="RThigh_Yaw_Link" />
    <child link="RThigh_Pitch_Link" />
    <axis xyz="0 1 0" />
    <limit lower="-2.0944" upper="0.349066" effort="1.0" velocity="1.0"/> <!-- 60 - (-120) degrees-->
    <dynamics damping="0.05" friction="0.5"/>
  </joint>

  <!-- Right Calf and Thigh -->
  <joint name="ThighCalf_Right" type="revolute">
    <origin xyz="0.0094239 0.039542 -0.32005" rpy="0 0 0" />
    <parent link="RThigh_Pitch_Link" />
    <child link="Calf_Right" />
    <axis xyz="0 1 0" />
    <limit lower="-0.349066" upper="1.74533" effort="1.0" velocity="1.0"/> <!-- (-20) - 100 degrees-->
    <dynamics damping="0.05" friction="0.5"/>
  </joint>

  <!-- Right Foot and Calf -->
  <joint name="CalfFoot_Right" type="revolute">
    <origin xyz="0.039418 0.002408 -0.17177" rpy="0 0 0" />
    <parent link="Calf_Right" />
    <child link="Foot_Right" />
    <axis xyz="0 1 0" />
    <limit lower="-0.785398" upper="0.785398" effort="1.0" velocity="1.0"/> <!-- 45 degrees-->
    <dynamics damping="0.05" friction="0.5"/>
  </joint>

  <!-- ****************************   IMU Sensor   **************************** -->
  <!-- IMU Link -->
  <link name="imu_link">
    <inertial>
        <mass value = "0.1"/>
        <origin value = "0 0 0"/>
        <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.01"/>
    </inertial>

    <visual>
        <geometry>
            <sphere radius="0.005"/>
        </geometry>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </visual>

    <collision>
        <geometry>
            <sphere radius="0.005"/>
        </geometry>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
  </link>

  <!-- IMU Joint -->
  <joint name="imu_base_link_joint" type="fixed">
      <parent link="base_link"/>
      <child link="imu_link"/>
      <origin xyz="0 0.01 0.6" rpy="0 0 0"/>
  </joint>

  <!-- IMU Ouput Definition -->
  <gazebo reference="imu_link">
    <gravity>true</gravity>
    <sensor name="imu_sensor" type="imu">
    <always_on>true</always_on>
    <update_rate>100</update_rate>
    <visualize>true</visualize>
    <plugin filename="libgazebo_ros_imu_sensor.so" name="imu_plugin">
        <bodyName>imu_link</bodyName>
        <updateRateHZ>10.0</updateRateHZ>
        <gaussianNoise>0.05</gaussianNoise>
        <xyzOffset>0 0 0</xyzOffset>
        <rpyOffset>0 0 0</rpyOffset>
        <frameName>imu_link</frameName>
        <initialOrientationAsReference>false</initialOrientationAsReference>
    </plugin>
    <pose>0 0 0 0 0 0</pose>
    </sensor>
  </gazebo> 

  <!-- *****************   Force-Torque Sensors on All Joints   ***************** -->
  <!-- Neck Yaw -->
  <gazebo reference="Neck_Yaw">
    <sensor name="force_torque_sensor" type="force_torque">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <visualize>true</visualize>
      <topic>force_torque1</topic>
      <force_torque>
        <frame>child</frame>
        <measure_direction>parent_to_child</measure_direction>
      </force_torque>
      <pose>0 0 0 0 0 0</pose>
    </sensor>
  </gazebo>

  <!-- Neck Pitch -->
  <gazebo reference="Neck_Pitch">
    <sensor name="force_torque_sensor" type="force_torque">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <visualize>true</visualize>
      <topic>force_torque11</topic>
      <force_torque>
        <frame>child</frame>
        <measure_direction>parent_to_child</measure_direction>
      </force_torque>
      <pose>0 0 0 0 0 0</pose>
    </sensor>
  </gazebo>

  <!-- Left Shoulder Pitch -->
  <gazebo reference="TorsoShoulder_Left_Pitch">
    <sensor name="force_torque_sensor" type="force_torque">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <visualize>true</visualize>
