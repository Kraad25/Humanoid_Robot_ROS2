  <!-- ****************************   Contact Sensors   **************************** -->
  <gazebo reference="Foot_Right">
    <sensor name="contact_sensor_right" type="contact">
      <update_rate>100</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <contact>
        <collision>Foot_Right_collision</collision>
      </contact>
    </sensor>
  </gazebo>

  <gazebo reference="Foot_Left">
    <sensor name="contact_sensor_left" type="contact">
      <update_rate>100</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <contact>
        <collision>Foot_Left_collision</collision>
      </contact>
    </sensor>
  </gazebo>
  
  <!-- ****************************   Joint States   **************************** -->
  <gazebo>
    <plugin name="joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
      <ros>
        <namespace>/</namespace>
        <remapping>joint_states:=/joint_states</remapping>
      </ros>

      <joint_name>Neck_Pitch</joint_name>
      <joint_name>Neck_Yaw</joint_name>

      <joint_name>TorsoShoulder_Left_Pitch</joint_name>
      <joint_name>TorsoShoulder_Left_Roll</joint_name>
      <joint_name>ShoulderElbow_Left</joint_name>

      <joint_name>TorsoShoulder_Right_Pitch</joint_name>
      <joint_name>TorsoShoulder_Right_Roll</joint_name>
      <joint_name>ShoulderElbow_Right</joint_name>

      <joint_name>TorsoThigh_Left_Pitch</joint_name>
      <joint_name>TorsoThigh_Left_Yaw</joint_name>
      <joint_name>ThighCalf_Left</joint_name>
      <joint_name>CalfFoot_Left</joint_name>

      <joint_name>TorsoThigh_Right_Pitch</joint_name>
      <joint_name>TorsoThigh_Right_Yaw</joint_name>
      <joint_name>ThighCalf_Right</joint_name>
      <joint_name>CalfFoot_Right</joint_name>

      <update_rate>50</update_rate>
    </plugin>
  </gazebo>

  <!-- ****************************   ROS2 Control   **************************** -->
  <gazebo>
    <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
      <parameters>$(find humanoid_robot)/config/controller_config.yaml</parameters>
    </plugin>
  </gazebo>

  <ros2_control name="GazeboSystem" type="gazebo_ros2_control/GazeboSystem">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>

    <joint name="Neck_Yaw">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="Neck_Pitch">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="TorsoShoulder_Left_Pitch">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="TorsoShoulder_Left_Roll">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="ShoulderElbow_Left">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="TorsoShoulder_Right_Pitch">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="TorsoShoulder_Right_Roll">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="ShoulderElbow_Right">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="TorsoThigh_Left_Pitch">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="TorsoThigh_Left_Yaw">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="ThighCalf_Left">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="CalfFoot_Left">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="TorsoThigh_Right_Pitch">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="TorsoThigh_Right_Yaw">
      <command_interface name="position"/>
