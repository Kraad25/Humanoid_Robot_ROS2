      <mass value="0.0204755663453671" />
      <inertia
        ixx="2.48857313055502E-06" ixy="1.58933146859342E-11" ixz="-1.53587889097411E-11"
        iyy="2.48861362838572E-06" iyz="1.0524516855652E-12" izz="2.30241709600154E-06" />
