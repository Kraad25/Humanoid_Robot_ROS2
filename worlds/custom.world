<?xml version="1.0" ?>
<sdf version="1.7">
  <world name="custom_world">

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <plugin name="contact_bridge_plugin" filename="libcontact_bridge_plugin.so">
      <ros>
        <namespace>/</namespace>
      </ros>
      <update_rate>100.0</update_rate>
    </plugin>

    <plugin name="set_entity_state_plugin" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/</namespace>
      </ros>
    </plugin>

    <plugin name="reset_joints_plugin" filename="libreset_joints_plugin.so">
      <ros>
        <namespace>/</namespace>
      </ros>
    </plugin>
    
    <gui>
      <camera name="gzclient_camera">
        <pose>2.112227 -0.721824 1.194857 0 0.295601 2.816199</pose>
      </camera>
    </gui>

    <scene>
      <shadows>0</shadows>
      <grid>true</grid>
      <origin_visual>false</origin_visual>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>0</cast_shadows>
      <pose>0 0 10 0 -0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>50</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.5 -1</direction>
    </light>

    <physics type="ode">
      <gravity>0 0 -9.81</gravity>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
    </physics>

    <model name="table">
      <static>true</static>
      <pose>1.2 0 0.3 0 0 0</pose>
      <link name="table_link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.8 0.6 0.6</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.8 0.6 0.6</size>
            </box>
          </geometry>

          <material>
            <ambient>0.6 0.4 0.2 1</ambient>
            <diffuse>0.6 0.4 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="red_cube">
      <static>false</static>
      <pose>1.2 0.15 0.64 0 0 0</pose>

      <link name="cube_link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.08 0.08 0.08</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.08 0.08 0.08</size>
            </box>
          </geometry>

          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
